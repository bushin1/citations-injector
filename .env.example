# === Citations Injector — Configuration ===
# Place ce fichier à côté de l'exécutable et renomme-le en .env

# Token d'API (depuis le dashboard > Paramètres > API Extension)
EXT_TOKEN=

# URL du dashboard (ne change pas sauf en dev)
DASHBOARD_BASE=https://dashboard.allo-chantiers.com

# Intervalle de scan en ms (défaut: 3000)
POLL_INTERVAL=3000

# Port API locale GoLogin (défaut: 36912)
GOLOGIN_API_PORT=36912

# Ports debug manuels, séparés par virgule (optionnel)
# DEBUG_PORTS=12345,12346
