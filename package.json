{
  "name": "allo-chantiers",
  "version": "2.3.0",
  "description": "Companion local pour l'equipe Allo Chantiers — citations, GoLogin, et plus",
  "main": "src/electron-main.js",
  "bin": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "node src/main.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win"
  },
  "build": {
    "appId": "fr.allo-chantiers.companion",
    "productName": "Allo Chantiers",
    "directories": {
      "output": "dist"
    },
    "publish": [
      { "provider": "github", "owner": "bushin1", "repo": "citations-injector" }
    ],
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      { "from": "token.local", "to": "token.local" }
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "assets/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false
    },
    "dmg": {
      "title": "Allo Chantiers",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "puppeteer-core": "^23.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
